# Model (any Mastra model string; the matching provider key must be set)
DEEPSEEK_API_KEY=
ASKNOVA_MODEL=deepseek/deepseek-flash

# Company settings
ASKNOVA_COMPANY_NAME=
ASKNOVA_TIMEZONE=UTC

# Lookio (policy knowledge base or any company-wide knowledge bank the org. uses)
LOOKIO_MCP_SERVER=https://mcp.lookio.app/mcp
LOOKIO_API_KEY=
LOOKIO_ASSISTANT_ID=

# Storage (defaults to ./asknova.db)
ASKNOVA_DB_URL=

# Optional: public product docs MCP server
PRODUCT_DOCS_MCP_URL=
PRODUCT_DOCS_MCP_AUTH_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
